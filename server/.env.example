APP_NAME="eBarangay Mo"
APP_ENV=local
# Generate with: php artisan key:generate   (also the key that encrypts PII fields and uploads)
APP_KEY=
# NEVER true in production (CVE-2021-3129 class: debug pages leak secrets / enable RCE)
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Least-privilege app user (see database/sql/*.sql)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ebarangay
DB_USERNAME=ebarangay_app
DB_PASSWORD=
# Schema owner, used only by: php artisan migrate --database=migrator
DB_MIGRATOR_USERNAME=ebarangay_migrator
DB_MIGRATOR_PASSWORD=
# Path to CA cert to require TLS between app and MySQL (production)
MYSQL_ATTR_SSL_CA=

HASH_DRIVER=argon2id

# No sessions or DB cache are used: the API is token-based.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Security settings (config/security.php)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_SECURE=true
# Comma-separated exact origins; the Flutter dev server runs on :5000
ALLOWED_ORIGINS=http://localhost:5000
FORCE_HTTPS=false
